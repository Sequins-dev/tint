# Tint Linux arm64 development image (docs/linux-aarch64-target.md,
# "Linux development environment"). Build context: tools/linux.
FROM debian:trixie
ENV DEBIAN_FRONTEND=noninteractive COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN apt-get update && apt-get install -y --no-install-recommends \
      curl xz-utils ca-certificates git gdb lldb python3-lldb binutils file procps time strace linux-perf llvm \
    && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL https://nodejs.org/dist/v24.12.0/node-v24.12.0-linux-arm64.tar.xz | tar xJ -C /opt \
    && ln -sf /opt/node-v24.12.0-linux-arm64/bin/* /usr/local/bin/ \
    && corepack enable && corepack prepare pnpm@10.34.8 --activate
RUN git config --system --add safe.directory '*'

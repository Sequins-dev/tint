 "note": "Cumulative variants; S2/F2/Z2 include the shadow cost-model follow-up 7d59ed497. Instruction counts are one warm call (entry to return, callees included); bytes are the function's own code.",
 "probes": {
  "neon": "var STATE_HELD = 4;\nvar STATE_SUSPENDED = 2;\nfunction Box(v) { this.v = v; }\nBox.prototype.get = function () { return this.v; };\nfunction method(o) { const r = o.get(); return r; }\nfunction make(v) { const b = new Box(v); return b; }\nfunction Vec(x, y, z) { this.x = x; this.y = y; this.z = z; }\nVec.prototype.dot = function (other) { return this.x * other.x + this.y * other.y + this.z * other.z; };\nfunction dot(a, b) { return a.dot(b); }\nfunction Base() {}\nBase.prototype.deepGet = function () { return 7; };\nfunction Mid() {}\nMid.prototype = Object.create(Base.prototype);\nfunction Sub() {}\nSub.prototype = Object.create(Mid.prototype);\nfunction callDeep(s) { return s.deepGet(); }\nfunction Task(state, next) { this.state = state; this.next = next; }\nTask.prototype.isHeldOrSuspended = function () {\n  return (this.state & STATE_HELD) != 0 || this.state == STATE_SUSPENDED;\n};\nfunction walk(t) {\n  let n = 0;\n  for (let cur = t; cur != null; cur = cur.next) if (cur.isHeldOrSuspended()) n++;\n  return n;\n}\nfunction setState(t, v) { t.state = v; return v; }\nexport function run() {\n  let s = 0;\n  const o = new Box(1);\n  const a = new Vec(1, 2, 3), b = new Vec(4, 5, 6);\n  const sub = new Sub();\n  const t = new Task(0, new Task(4, new Task(2, null)));\n  for (let i = 0; i < 1000; i++) {\n    s += method(o) + make(i).v + dot(a, b) + callDeep(sub) + walk(t) + setState(t, i & 1);\n  }\n  return s > 0 ? 42 : 1;\n}\n",
  "call3": "function add(a, b) { return a + b; }\nfunction caller(a, b) { const r = add(a, b); return r; }\nfunction Box(v) { this.v = v; }\nBox.prototype.get = function () { return this.v; };\nfunction method(o) { const r = o.get(); return r; }\nfunction tail(a, b) { return add(a, b); }\nfunction make(v) { const b = new Box(v); return b; }\nexport function run() {\n  let s = 0;\n  const o = new Box(1);\n  for (let i = 0; i < 1000; i++) {\n    s += caller(i, 1) + method(o) + tail(i, 2) + make(i).v;\n  }\n  return s > 0 ? 42 : 1;\n}\n",
  "oldstore": "function Task(state, next) { this.state = state; this.next = next; }\nfunction setState(t, v) { t.state = v; return v; }\nfunction setNext(t, n) { t.next = n; return 0; }\nexport function run() {\n  const t = new Task(0, null);\n  // Survive several minor collections so t is old before the timed calls.\n  let keep = null;\n  for (let i = 0; i < 200000; i++) keep = new Task(i, keep === null || i % 64 === 0 ? null : keep);\n  let s = 0;\n  for (let i = 0; i < 1000; i++) s += setState(t, i & 1) + setNext(t, keep);\n  return s >= 0 ? 42 : 1;\n}\n"
 },

{
  "name": "tint-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.8",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "pnpm build && tsc -p tsconfig.tests.json && tsc -p tsconfig.host.json",
    "test": "pnpm build && node --test packages/*/test/*.test.ts tools/*.test.ts",
    "boundaries": "node tools/check-boundaries.ts",
    "format": "prettier --write packages tools types *.json pnpm-workspace.yaml",
    "format:check": "prettier --check packages tools types *.json pnpm-workspace.yaml",
    "check": "pnpm typecheck && pnpm test && pnpm boundaries && pnpm format:check",
    "verify:aarch64": "pnpm build && node tools/verify-aarch64.ts",
    "verify:macos": "pnpm build && node tools/verify-macos.ts",
    "verify:files": "pnpm build && node tools/verify-files.ts",
    "verify:scalar-native": "pnpm build && node tools/verify-scalar-native.ts",
    "verify:regions": "pnpm build && node tools/verify-regions.ts",
    "verify:cells": "pnpm build && node tools/verify-cells.ts",
    "verify:environments": "pnpm build && node tools/verify-environments.ts",
    "verify:closure-source": "pnpm build && node tools/verify-closure-source.ts",
    "verify:closure-factory": "pnpm build && node tools/verify-closure-factory.ts",
    "verify:native-allocator": "pnpm build && node tools/verify-native-allocator.ts",
    "selfhost:coverage": "pnpm build && node tools/selfhost-coverage.ts",
    "verify:roots": "pnpm build && node tools/verify-roots.ts",
    "verify:records": "pnpm build && node tools/verify-records.ts",
    "verify:construction": "pnpm build && node tools/verify-construction.ts",
    "verify:compaction": "pnpm build && node tools/verify-compaction.ts && node tools/verify-moving-runtime.ts",
    "verify:strings": "pnpm build && node tools/verify-strings.ts",
    "benchmark": "pnpm build && node tools/benchmark.ts"
  },
  "devDependencies": {
    "@tint/codegen": "workspace:*",
    "@tint/bench": "workspace:*",
    "@tint/ts-native": "workspace:*",
    "@tint/js-runtime": "workspace:*",
    "@tint/platform": "workspace:*",
    "@tint/native-runtime": "workspace:*",
    "@tint/typescript": "workspace:*",
    "@tint/source": "workspace:*",
    "@tint/js-engine": "workspace:*",
    "@tint/foundation": "workspace:*",
    "@types/node": "24.12.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "yaml": "2.9.1",
    "@tint/ir": "workspace:*",
    "@tint/abi": "workspace:*",
    "@tint/image": "workspace:*",
    "@tint/compiler": "workspace:*"
  }
}
